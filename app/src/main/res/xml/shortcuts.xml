<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="bubble"
        android:shortcutShortLabel="@string/shortcut_bubble"
        android:shortcutLongLabel="@string/shortcut_bubble_long"
        android:icon="@drawable/ic_sparkle">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="au.local.scribephone"
            android:targetClass="au.local.scribephone.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="settings"
        android:shortcutShortLabel="@string/shortcut_settings"
        android:shortcutLongLabel="@string/shortcut_settings_long"
        android:icon="@drawable/ic_settings">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="au.local.scribephone"
            android:targetClass="au.local.scribephone.MainActivity">
            <extra
                android:name="au.local.scribephone.EXTRA_SETTINGS"
                android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
